FROM node:22-bookworm-slim AS sofia-builder

WORKDIR /src

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
  && npm install -g bun \
  && corepack enable \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN pnpm install --frozen-lockfile --trust-lockfile --filter sofia-server... \
  && pnpm --filter sofia-server build \
  && pnpm --filter sofia-server build:bin

FROM node:22-bookworm-slim

ARG SOFIA_SERVER_VERSION
ARG SOFIA_ENGINE_VERSION
ARG SOFIA_ENGINE_DOWNLOAD_URL=

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar unzip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=sofia-builder /src/apps/server/dist/bin/sofia-server /usr/local/bin/sofia-server
COPY --from=sofia-builder /src/apps/server/dist/engine-plugins /opt/sofia/engine-plugins
COPY --from=sofia-builder /src/constants.json /usr/local/constants.json
COPY packaging/docker/microsandbox-entrypoint.sh /usr/local/bin/microsandbox-entrypoint.sh

RUN set -eux; \
  test -n "$SOFIA_SERVER_VERSION"; \
  test -n "$SOFIA_ENGINE_VERSION"; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) asset="engine-linux-x64-baseline.tar.gz" ;; \
    arm64) asset="engine-linux-arm64.tar.gz" ;; \
    *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
  esac; \
  url="$SOFIA_ENGINE_DOWNLOAD_URL"; \
  if [ -z "$url" ]; then \
    url="https://github.com/RuutChatCSM/sofia/releases/download/v${SOFIA_ENGINE_VERSION}/${asset}"; \
  fi; \
  tmpdir="$(mktemp -d)"; \
  curl -fsSL "$url" -o "$tmpdir/$asset"; \
  tar -xzf "$tmpdir/$asset" -C "$tmpdir"; \
  binary="$(find "$tmpdir" -type f -name engine | head -n 1)"; \
  test -n "$binary"; \
  install -m 0755 "$binary" /usr/local/bin/engine; \
  chmod +x /usr/local/bin/microsandbox-entrypoint.sh; \
  rm -rf "$tmpdir"

RUN test -f /opt/sofia/engine-plugins/sofia-extensions-preview.js \
  && test -f /opt/sofia/engine-plugins/sofia-capabilities-knowledge.js \
  && test -f /opt/sofia/engine-plugins/sofia-office-attachments.js \
  && test -f /opt/sofia/engine-plugins/sofia-anthropic-adaptive-thinking.js \
  && test -f /opt/sofia/engine-plugins/sofia-anthropic-tool-schema.js \
  && test "$(sofia-server --version)" = "$SOFIA_SERVER_VERSION" \
  && engine --version

ENV SOFIA_EXTENSIONS_PLUGIN_DIR=/opt/sofia/engine-plugins
ENV SOFIA_DATA_DIR=/data/sofia-server
ENV SOFIA_SIDECAR_DIR=/data/sidecars
ENV SOFIA_WORKSPACE=/workspace

EXPOSE 8787

VOLUME ["/workspace", "/data"]

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
  CMD /bin/sh -c 'curl -fsS "http://127.0.0.1:${SOFIA_PORT:-8787}/health" >/dev/null || exit 1'

ENTRYPOINT ["/usr/local/bin/microsandbox-entrypoint.sh"]
