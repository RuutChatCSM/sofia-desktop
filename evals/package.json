{
  "name": "@sofia/evals",
  "private": true,
  "type": "module",
  "scripts": {
    "test:pr": "vitest run --config vitest.config.ts --project pr",
    "test:e2e": "vitest run --config vitest.config.ts --project e2e",
    "artifacts:index": "node packages/test-artifacts/bin/artifact-index.mjs",
    "artifacts:publish": "node packages/test-artifacts/bin/publish-pr.mjs",
    "dev:den": "node scripts/dev-den.ts",
    "docs:shots": "node docs-shots/run.ts",
    "evidence:judge": "node packages/test-evidence/bin/test-evidence-judge.mjs",
    "provision:org-connector-two-members": "node scripts/provision-org-connector-two-members.ts",
    "test": "node --test runner/*.test.ts packages/*/test/*.test.ts bin/*.test.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@sofia/behaviors": "workspace:*",
    "@sofia/cdp": "workspace:*",
    "@sofia/test-artifacts": "workspace:*",
    "@sofia/test-evidence": "workspace:*",
    "@sofia/hosts": "workspace:*",
    "@sofia/labs": "workspace:*",
    "@sofia/matchers": "workspace:*",
    "@sofia/testkit": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.4.0"
}
